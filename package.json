{
  "name": "atelier-de-vise",
  "version": "1.0.0",
  "private": true,
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch --env-file=.env server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --mode pages --outDir dist-pages",
    "build:mobile": "tsc -b && vite build --mode mobile --outDir dist-mobile",
    "mobile:sync": "npm run build:mobile && cap sync",
    "mobile:ios": "npm run mobile:sync && cap open ios",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:run:ios": "npm run mobile:sync && cap run ios",
    "mobile:run:android": "npm run mobile:sync && cap run android",
    "mobile:assets": "node scripts/mobile-assets.mjs",
    "preview:mobile": "vite preview --mode mobile-demo --outDir dist-mobile --host 127.0.0.1 --port 4175 --strictPort",
    "test:mobile": "npm run build:mobile:demo && playwright test --config playwright.mobile.config.ts",
    "preview:pages": "vite preview --mode pages --outDir dist-pages --host 127.0.0.1 --port 4174 --strictPort",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "start": "node --env-file=.env server/index.js",
    "db:migrate": "node --env-file=.env server/migrate.js",
    "db:seed": "node --env-file=.env server/seed.js",
    "admin:create": "node --env-file=.env server/create-admin.js",
    "test": "node --env-file=.env --test --test-concurrency=1 tests/*.test.js",
    "test:browser": "node --env-file=.env node_modules/@playwright/test/cli.js test",
    "format": "prettier --write src server tests vite.config.ts playwright.config.ts",
    "build:mobile:demo": "tsc -b && vite build --mode mobile-demo --outDir dist-mobile",
    "mobile:sync:demo": "npm run build:mobile:demo && cap sync",
    "release:android": "node scripts/check-release.mjs && npm run mobile:sync && cd android && ./gradlew bundleRelease",
    "release:ios": "node scripts/check-release.mjs && npm run mobile:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "mysql2": "^3.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.4",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.6",
    "supertest": "^7.1.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  }
}
