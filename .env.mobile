# Public build flags only. Live store apps: real events and bookings from the production API.
# Set the API address in .env.mobile.local (not versioned) or the environment, e.g.:
#   VITE_API_URL=https://atelierdevise.ro
# The server must list the app origins in NATIVE_ORIGINS (default already covers iOS + Android).
VITE_NATIVE_APP=true
VITE_BASE_PATH=/
